{
  "name": "@bitbarrel/client",
  "version": "1.0.0",
  "description": "TypeScript client library for BitBarrel key-value storage",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "bitbarrel",
    "key-value",
    "storage",
    "database",
    "typescript"
  ],
  "author": "BitBarrel Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bitbarrel/bitbarrel.git",
    "directory": "clients/typescript"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/ws": "^8.5.10",
    "@vitest/coverage-v8": "^1.0.4",
    "@vitest/ui": "^1.0.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.2",
    "vitest": "^1.0.4"
  }
}
